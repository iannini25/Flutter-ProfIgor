rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /usuarios/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == id;
    }

    match /publicacoes/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.usuarioId == request.auth.uid;
    }

    match /comentarios/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.usuarioId == request.auth.uid;
      // so quem fez o comentario pode excluir
      allow delete: if request.auth != null && resource.data.usuarioId == request.auth.uid;
    }
  }
}
